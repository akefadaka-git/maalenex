# Copy to the hosting provider's secret/environment settings. Do not commit real values.
APP_ENV=production
APP_NAME=MaaleNex Moto
API_PREFIX=/api/v1
# Replace sslrootcert with the CA bundle supplied by the managed PostgreSQL provider.
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=verify-full&sslrootcert=%2Fpath%2Fto%2Fprovider-ca.pem
SYNTHETIC_DATA_ONLY=false
SECURE_COOKIES=true
CORS_ORIGINS=https://appassets.androidplatform.net,https://passenger.example.com,https://admin.example.com
PORT=8000
WEB_CONCURRENCY=2
# Set this to the exact trusted reverse-proxy source IP(s) supplied by the hosting provider.
# Never use '*' unless the app is network-isolated behind that proxy and this risk is explicitly accepted.
FORWARDED_ALLOW_IPS=127.0.0.1
# Keep false on the API web service; run a separate worker service with this set to true.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=30
SCHEDULER_LEASE_SECONDS=90
SCHEDULER_BATCH_SIZE=100
# Configure only after a real S3-compatible bucket and credentials are provisioned.
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_PROVIDER=r2
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
