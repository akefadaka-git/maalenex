# General account identity encryption keys: generate independently; never commit real values.
IDENTITY_ENCRYPTION_KEY=
IDENTITY_LOOKUP_KEY=
IDENTITY_EXPOSE_TEST_TOKENS=false

# Email challenge delivery is disabled unless explicitly enabled.
IDENTITY_EMAIL_DELIVERY_ENABLED=false
IDENTITY_SMTP_HOST=
IDENTITY_SMTP_PORT=587
IDENTITY_SMTP_USERNAME=
IDENTITY_SMTP_PASSWORD=
IDENTITY_SMTP_FROM_EMAIL=
IDENTITY_SMTP_FROM_NAME=MaaleNex
IDENTITY_SMTP_STARTTLS=true
IDENTITY_SMTP_USE_SSL=false
IDENTITY_SMTP_TIMEOUT_SECONDS=10

# SMS delivery is not active in this increment. No SMS provider credentials are expected.
